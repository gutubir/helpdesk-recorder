# Copie para .env e preencha. O .env NÃO vai para o Git.

# Token que o app Windows envia no cabeçalho "Authorization: Bearer <token>".
# Vazio = sem autenticação (aceitável só rodando em localhost).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Transcrição: "openai" (API) ou "fake" (teste, sem custo)
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
# Precisa devolver segmentos com tempo; por isso whisper-1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=pt

# Onde ficam áudios e banco (padrão: ./data)
# DATA_DIR=data
# DB_PATH=data/helpdesk.db

# Limite por arquivo enviado
MAX_UPLOAD_MB=300

# Caminho do ffmpeg, se não estiver no PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
